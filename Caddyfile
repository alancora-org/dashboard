{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8081} {
	header Cache-Control "no-store"
	handle /js/config.js {
		header Content-Type text/javascript
		templates {
			mime text/javascript
			between [[ ]]
		}
		respond `const API_URL = [[ env "API_URL" | default "http://localhost:8080" | toJson ]];`
	}
	handle {
		root * .
		file_server {
			hide .git .env* Caddyfile railway.json
		}
	}
}
